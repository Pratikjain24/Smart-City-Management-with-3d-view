# ========================================================
# MAHATWIN MUMBAI - ENVIRONMENT CONFIGURATION
# ========================================================

# Google Photorealistic 3D Tiles API Key
# (Leave empty for fallback Cesium 3D World Terrain + OSM buildings)
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Cesium Ion Access Token (Optional)
VITE_CESIUM_ION_TOKEN=
CESIUM_ION_TOKEN=

# Database Configuration (PostgreSQL / PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mahatwin_mumbai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahatwin_mumbai

# Redis Event Broker
REDIS_URL=redis://localhost:6379/0

# Backend Settings
PROJECT_NAME="MahaTwin Mumbai"
DEBUG=True
ENVIRONMENT=development
